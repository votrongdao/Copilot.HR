// Performance Dashboard - screen-specific DBML
// Dashboard metrics should be calculated from transactional tables rather than stored redundantly.

Enum review_cycle_status {
  draft
  open
  in_progress
  completed
  archived
}

Enum goal_status {
  draft
  active
  completed
  cancelled
  overdue
}

Enum review_assignment_status {
  not_started
  in_progress
  submitted
  approved
  overdue
}

Enum activity_type {
  goal_created
  goal_updated
  review_started
  self_assessment_submitted
  manager_evaluation_submitted
  feedback_requested
  feedback_submitted
  review_completed
}

Table users {
  id bigint [pk, increment]
  employee_code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  avatar_url varchar(500)
  department varchar(150)
  job_title varchar(150)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_cycles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  review_type varchar(50) [not null]
  start_date date [not null]
  end_date date [not null]
  status review_cycle_status [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_assignments {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  employee_id bigint [not null]
  manager_id bigint
  status review_assignment_status [not null]
  due_date date
  submitted_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (review_cycle_id, employee_id) [unique]
  }
}

Table goals {
  id bigint [pk, increment]
  review_cycle_id bigint
  owner_id bigint [not null]
  title varchar(255) [not null]
  description text
  status goal_status [not null]
  progress_percent decimal(5,2) [not null, default: 0]
  start_date date
  due_date date
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    owner_id
    review_cycle_id
    status
  }
}

Table goal_progress_snapshots {
  id bigint [pk, increment]
  goal_id bigint [not null]
  progress_percent decimal(5,2) [not null]
  recorded_at timestamp [not null]
  recorded_by bigint [not null]
  note text
}

Table activity_events {
  id bigint [pk, increment]
  actor_id bigint [not null]
  activity_type activity_type [not null]
  review_cycle_id bigint
  goal_id bigint
  target_user_id bigint
  title varchar(255) [not null]
  description text
  occurred_at timestamp [not null]

  Indexes {
    actor_id
    occurred_at
  }
}

Ref: review_assignments.review_cycle_id > review_cycles.id
Ref: review_assignments.employee_id > users.id
Ref: review_assignments.manager_id > users.id

Ref: goals.review_cycle_id > review_cycles.id
Ref: goals.owner_id > users.id

Ref: goal_progress_snapshots.goal_id > goals.id
Ref: goal_progress_snapshots.recorded_by > users.id

Ref: activity_events.actor_id > users.id
Ref: activity_events.review_cycle_id > review_cycles.id
Ref: activity_events.goal_id > goals.id
Ref: activity_events.target_user_id > users.id
