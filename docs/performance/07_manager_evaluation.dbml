// Manager Evaluation Screen - screen-specific DBML

Enum evaluation_status {
  draft
  in_progress
  submitted
  approved
  reopened
}

Table users {
  id bigint [pk, increment]
  employee_code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  avatar_url varchar(500)
  department varchar(150)
  job_title varchar(150)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_cycles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  start_date date [not null]
  end_date date [not null]
  status varchar(30) [not null]
}

Table competencies {
  id bigint [pk, increment]
  name varchar(150) [not null, unique]
  description text
  category varchar(100)
  is_active boolean [not null, default: true]
}

Table evaluation_templates {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text
  version int [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
}

Table evaluation_questions {
  id bigint [pk, increment]
  template_id bigint [not null]
  competency_id bigint
  section_name varchar(150) [not null]
  question_text text [not null]
  max_score decimal(5,2) [not null, default: 5]
  weight decimal(6,3) [not null, default: 1]
  sort_order int [not null, default: 0]
  is_required boolean [not null, default: true]
}

Table manager_evaluations {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  employee_id bigint [not null]
  manager_id bigint [not null]
  template_id bigint [not null]
  status evaluation_status [not null]
  overall_score decimal(5,2)
  summary_comment text
  started_at timestamp
  submitted_at timestamp
  approved_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (review_cycle_id, employee_id) [unique]
    manager_id
    status
  }
}

Table manager_evaluation_answers {
  id bigint [pk, increment]
  evaluation_id bigint [not null]
  question_id bigint [not null]
  score decimal(5,2)
  comment_text text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (evaluation_id, question_id) [unique]
  }
}

Table evaluation_comments {
  id bigint [pk, increment]
  evaluation_id bigint [not null]
  author_id bigint [not null]
  comment_type varchar(50) [not null]
  comment_text text [not null]
  created_at timestamp [not null]
}

Ref: competencies.id < evaluation_questions.competency_id
Ref: evaluation_templates.id < evaluation_questions.template_id

Ref: review_cycles.id < manager_evaluations.review_cycle_id
Ref: users.id < manager_evaluations.employee_id
Ref: users.id < manager_evaluations.manager_id
Ref: evaluation_templates.id < manager_evaluations.template_id

Ref: manager_evaluations.id < manager_evaluation_answers.evaluation_id
Ref: evaluation_questions.id < manager_evaluation_answers.question_id

Ref: manager_evaluations.id < evaluation_comments.evaluation_id
Ref: users.id < evaluation_comments.author_id
