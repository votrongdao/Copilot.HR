// Final Performance Report - screen-specific DBML
// Report is a generated snapshot of the review outcome.
// Source evaluations remain immutable transactional records.

Enum report_status {
  draft
  generated
  published
  acknowledged
  superseded
}

Table users {
  id bigint [pk, increment]
  employee_code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  avatar_url varchar(500)
  department varchar(150)
  job_title varchar(150)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_cycles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  start_date date [not null]
  end_date date [not null]
  status varchar(30) [not null]
}

Table manager_evaluations {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  employee_id bigint [not null]
  manager_id bigint [not null]
  overall_score decimal(5,2)
  status varchar(30) [not null]
  submitted_at timestamp
  approved_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table final_performance_reports {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  employee_id bigint [not null]
  manager_evaluation_id bigint
  report_version int [not null, default: 1]
  overall_score decimal(5,2) [not null]
  performance_rating varchar(100)
  summary text
  strengths text
  development_areas text
  recommendations text
  status report_status [not null]
  generated_at timestamp
  published_at timestamp
  acknowledged_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (review_cycle_id, employee_id, report_version) [unique]
    status
  }
}

Table performance_dimensions {
  id bigint [pk, increment]
  name varchar(150) [not null, unique]
  description text
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table report_dimension_scores {
  id bigint [pk, increment]
  report_id bigint [not null]
  dimension_id bigint [not null]
  score decimal(5,2) [not null]
  weight decimal(6,3) [not null, default: 1]
  comment text

  Indexes {
    (report_id, dimension_id) [unique]
  }
}

Table report_achievements {
  id bigint [pk, increment]
  report_id bigint [not null]
  title varchar(255) [not null]
  description text
  source_type varchar(50)
  source_id bigint
  sort_order int [not null, default: 0]
}

Table report_goals {
  id bigint [pk, increment]
  report_id bigint [not null]
  goal_title varchar(255) [not null]
  final_progress_percent decimal(5,2)
  outcome_text text
  sort_order int [not null, default: 0]
}

Table report_feedback_summary {
  id bigint [pk, increment]
  report_id bigint [not null, unique]
  reviewer_count int [not null, default: 0]
  average_score decimal(5,2)
  strengths text
  development_areas text
}

Table report_acknowledgements {
  id bigint [pk, increment]
  report_id bigint [not null]
  user_id bigint [not null]
  acknowledged_at timestamp [not null]
  comment text

  Indexes {
    (report_id, user_id) [unique]
  }
}

Ref: review_cycles.id < manager_evaluations.review_cycle_id
Ref: users.id < manager_evaluations.employee_id
Ref: users.id < manager_evaluations.manager_id

Ref: review_cycles.id < final_performance_reports.review_cycle_id
Ref: users.id < final_performance_reports.employee_id
Ref: manager_evaluations.id < final_performance_reports.manager_evaluation_id

Ref: final_performance_reports.id < report_dimension_scores.report_id
Ref: performance_dimensions.id < report_dimension_scores.dimension_id

Ref: final_performance_reports.id < report_achievements.report_id
Ref: final_performance_reports.id < report_goals.report_id

Ref: final_performance_reports.id - report_feedback_summary.report_id

Ref: final_performance_reports.id < report_acknowledgements.report_id
Ref: users.id < report_acknowledgements.user_id
