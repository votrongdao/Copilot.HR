// ============================================================
// HR PLATFORM - PERFORMANCE MANAGEMENT
// DBML for dbdiagram.io
// Scope: Core HR references + Goal Management + Performance Review + One-on-One Coaching
// ============================================================

Enum employee_status {
  active
  inactive
  probation
  suspended
  terminated
  on_leave
}

Enum employment_type {
  permanent
  fixed_term
  part_time
  contractor
  intern
}

Enum goal_status {
  draft
  pending_approval
  active
  needs_revision
  completed
  cancelled
}

Enum goal_progress_status {
  not_started
  on_track
  at_risk
  off_track
  completed
}

Enum goal_owner_type {
  individual
  team
  department
  organization
}

Enum goal_approval_status {
  pending
  approved
  rejected
  revision_requested
}

Enum review_cycle_status {
  draft
  scheduled
  active
  calibration
  completed
  cancelled
}

Enum review_status {
  not_started
  self_assessment
  manager_review
  calibration
  pending_approval
  revision_requested
  approved
  published
  cancelled
}

Enum review_participant_role {
  employee
  manager
  peer
  hr
}

Enum feedback_type {
  self_assessment
  manager_feedback
  peer_feedback
  hr_feedback
}

Enum approval_decision {
  pending
  approved
  rejected
  revision_requested
}

Enum one_on_one_status {
  requested
  scheduled
  completed
  cancelled
  rescheduled
}

Enum action_item_status {
  open
  in_progress
  completed
  cancelled
}

Enum action_item_priority {
  low
  medium
  high
  urgent
}

Table organization {
  id uuid [pk]
  code varchar(50) [not null, unique]
  name varchar(200) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table department {
  id uuid [pk]
  organization_id uuid [not null]
  parent_department_id uuid
  code varchar(50) [not null]
  name varchar(200) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (organization_id, code) [unique]
    organization_id
    parent_department_id
  }
}

Table position {
  id uuid [pk]
  organization_id uuid [not null]
  code varchar(50) [not null]
  title varchar(200) [not null]
  description text
  level varchar(50)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (organization_id, code) [unique]
    organization_id
  }
}

Table employee {
  id uuid [pk]
  organization_id uuid [not null]
  employee_number varchar(50) [not null]
  first_name varchar(100) [not null]
  middle_name varchar(100)
  last_name varchar(100) [not null]
  display_name varchar(250)
  email varchar(255)
  avatar_url varchar(500)
  phone varchar(50)
  date_of_birth date
  hire_date date
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (organization_id, employee_number) [unique]
    organization_id
    email
  }
}

Table employee_assignment {
  id uuid [pk]
  employee_id uuid [not null]
  department_id uuid [not null]
  position_id uuid [not null]
  manager_employee_id uuid
  employment_type employment_type [not null]
  status employee_status [not null]
  start_date date [not null]
  end_date date
  is_current boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    employee_id
    department_id
    position_id
    manager_employee_id
    (employee_id, is_current)
  }
}

// ============================================================
// GOAL MANAGEMENT
// ============================================================

Table goal_cycle {
  id uuid [pk]
  organization_id uuid [not null]
  name varchar(200) [not null]
  description text
  start_date date [not null]
  end_date date [not null]
  allow_employee_goal_creation boolean [not null]
  require_manager_approval boolean [not null]
  is_active boolean [not null]
  created_by_employee_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    organization_id
    created_by_employee_id
    (organization_id, start_date, end_date)
  }
}

Table performance_goal {
  id uuid [pk]
  goal_cycle_id uuid [not null]
  organization_id uuid [not null]
  owner_type goal_owner_type [not null]
  owner_employee_id uuid
  department_id uuid
  parent_goal_id uuid
  title varchar(250) [not null]
  description text
  success_criteria text
  weight decimal(5,2)
  target_value decimal(15,2)
  current_value decimal(15,2)
  unit varchar(50)
  start_date date [not null]
  due_date date [not null]
  status goal_status [not null]
  progress_status goal_progress_status [not null]
  created_by_employee_id uuid [not null]
  approved_by_employee_id uuid
  approved_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    goal_cycle_id
    organization_id
    owner_employee_id
    department_id
    parent_goal_id
    status
    due_date
  }
}

Table goal_progress_update {
  id uuid [pk]
  goal_id uuid [not null]
  previous_value decimal(15,2)
  new_value decimal(15,2)
  previous_progress_status goal_progress_status
  new_progress_status goal_progress_status [not null]
  progress_percent decimal(5,2)
  comment text
  updated_by_employee_id uuid [not null]
  created_at timestamp [not null]

  indexes {
    goal_id
    updated_by_employee_id
    created_at
  }
}

Table goal_approval {
  id uuid [pk]
  goal_id uuid [not null]
  reviewer_employee_id uuid [not null]
  status goal_approval_status [not null]
  comment text
  requested_at timestamp [not null]
  decided_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    goal_id
    reviewer_employee_id
    status
  }
}

Table goal_revision_request {
  id uuid [pk]
  goal_id uuid [not null]
  requested_by_employee_id uuid [not null]
  reason text [not null]
  requested_at timestamp [not null]
  resolved_at timestamp
  is_resolved boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    goal_id
    requested_by_employee_id
    is_resolved
  }
}

Table goal_history {
  id uuid [pk]
  goal_id uuid [not null]
  changed_by_employee_id uuid [not null]
  event_type varchar(100) [not null]
  field_name varchar(100)
  old_value text
  new_value text
  note text
  created_at timestamp [not null]

  indexes {
    goal_id
    changed_by_employee_id
    created_at
  }
}

// ============================================================
// PERFORMANCE REVIEW MANAGEMENT
// ============================================================

Table performance_review_cycle {
  id uuid [pk]
  organization_id uuid [not null]
  name varchar(200) [not null]
  description text
  review_period_start date [not null]
  review_period_end date [not null]
  self_assessment_start date
  self_assessment_due date
  manager_review_start date
  manager_review_due date
  peer_feedback_enabled boolean [not null]
  calibration_enabled boolean [not null]
  status review_cycle_status [not null]
  created_by_employee_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    organization_id
    status
    created_by_employee_id
  }
}

Table review_template {
  id uuid [pk]
  organization_id uuid [not null]
  name varchar(200) [not null]
  description text
  version integer [not null]
  is_active boolean [not null]
  created_by_employee_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    organization_id
    is_active
  }
}

Table review_template_section {
  id uuid [pk]
  review_template_id uuid [not null]
  name varchar(200) [not null]
  description text
  display_order integer [not null]
  weight decimal(5,2)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    review_template_id
    (review_template_id, display_order) [unique]
  }
}

Table review_question {
  id uuid [pk]
  review_template_section_id uuid [not null]
  question_text text [not null]
  question_type varchar(50) [not null]
  weight decimal(5,2)
  is_required boolean [not null]
  display_order integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    review_template_section_id
    (review_template_section_id, display_order) [unique]
  }
}

Table performance_review {
  id uuid [pk]
  review_cycle_id uuid [not null]
  review_template_id uuid [not null]
  employee_id uuid [not null]
  manager_employee_id uuid [not null]
  status review_status [not null]
  overall_rating decimal(4,2)
  manager_summary text
  employee_acknowledgement text
  submitted_self_assessment_at timestamp
  manager_review_completed_at timestamp
  final_approved_at timestamp
  published_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (review_cycle_id, employee_id) [unique]
    review_cycle_id
    employee_id
    manager_employee_id
    status
  }
}

Table review_participant {
  id uuid [pk]
  performance_review_id uuid [not null]
  employee_id uuid [not null]
  role review_participant_role [not null]
  invited_at timestamp
  submitted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (performance_review_id, employee_id, role) [unique]
    performance_review_id
    employee_id
  }
}

Table review_feedback {
  id uuid [pk]
  performance_review_id uuid [not null]
  reviewer_employee_id uuid [not null]
  feedback_type feedback_type [not null]
  overall_rating decimal(4,2)
  strengths text
  development_areas text
  comments text
  is_submitted boolean [not null]
  submitted_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    performance_review_id
    reviewer_employee_id
    feedback_type
  }
}

Table review_answer {
  id uuid [pk]
  review_feedback_id uuid [not null]
  review_question_id uuid [not null]
  rating_value decimal(4,2)
  text_value text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (review_feedback_id, review_question_id) [unique]
    review_feedback_id
    review_question_id
  }
}

Table review_approval {
  id uuid [pk]
  performance_review_id uuid [not null]
  approver_employee_id uuid [not null]
  decision approval_decision [not null]
  comment text
  requested_at timestamp [not null]
  decided_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    performance_review_id
    approver_employee_id
    decision
  }
}

Table review_correction_request {
  id uuid [pk]
  performance_review_id uuid [not null]
  requested_by_employee_id uuid [not null]
  reason text [not null]
  requested_at timestamp [not null]
  resolved_by_employee_id uuid
  resolved_at timestamp
  resolution_note text
  is_resolved boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    performance_review_id
    requested_by_employee_id
    is_resolved
  }
}

Table review_history {
  id uuid [pk]
  performance_review_id uuid [not null]
  changed_by_employee_id uuid [not null]
  event_type varchar(100) [not null]
  old_status review_status
  new_status review_status
  note text
  created_at timestamp [not null]

  indexes {
    performance_review_id
    changed_by_employee_id
    created_at
  }
}

// ============================================================
// ONE-ON-ONE COACHING MANAGEMENT
// ============================================================

Table coaching_template {
  id uuid [pk]
  organization_id uuid [not null]
  name varchar(200) [not null]
  description text
  is_active boolean [not null]
  created_by_employee_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    organization_id
    is_active
  }
}

Table coaching_template_item {
  id uuid [pk]
  coaching_template_id uuid [not null]
  title varchar(200) [not null]
  prompt_text text
  display_order integer [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    coaching_template_id
    (coaching_template_id, display_order) [unique]
  }
}

Table one_on_one_session {
  id uuid [pk]
  organization_id uuid [not null]
  employee_id uuid [not null]
  manager_employee_id uuid [not null]
  coaching_template_id uuid
  title varchar(200)
  status one_on_one_status [not null]
  requested_at timestamp
  scheduled_start timestamp
  scheduled_end timestamp
  completed_at timestamp
  cancelled_at timestamp
  location varchar(250)
  meeting_url varchar(500)
  created_by_employee_id uuid [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    organization_id
    employee_id
    manager_employee_id
    status
    scheduled_start
  }
}

Table one_on_one_agenda_item {
  id uuid [pk]
  one_on_one_session_id uuid [not null]
  created_by_employee_id uuid [not null]
  title varchar(250) [not null]
  description text
  display_order integer [not null]
  is_discussed boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    one_on_one_session_id
    created_by_employee_id
    (one_on_one_session_id, display_order) [unique]
  }
}

Table one_on_one_note {
  id uuid [pk]
  one_on_one_session_id uuid [not null]
  author_employee_id uuid [not null]
  note_text text [not null]
  is_shared boolean [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    one_on_one_session_id
    author_employee_id
  }
}

Table coaching_action_item {
  id uuid [pk]
  one_on_one_session_id uuid [not null]
  assigned_to_employee_id uuid [not null]
  created_by_employee_id uuid [not null]
  title varchar(250) [not null]
  description text
  priority action_item_priority [not null]
  status action_item_status [not null]
  due_date date
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    one_on_one_session_id
    assigned_to_employee_id
    status
    due_date
  }
}

Table coaching_history {
  id uuid [pk]
  one_on_one_session_id uuid [not null]
  changed_by_employee_id uuid [not null]
  event_type varchar(100) [not null]
  note text
  created_at timestamp [not null]

  indexes {
    one_on_one_session_id
    changed_by_employee_id
    created_at
  }
}

// Optional materialized/reporting snapshot. Remove if reports are calculated dynamically.
Table employee_performance_summary {
  id uuid [pk]
  employee_id uuid [not null]
  review_cycle_id uuid
  goal_completion_percent decimal(5,2)
  average_goal_progress decimal(5,2)
  overall_review_rating decimal(4,2)
  one_on_one_sessions_count integer
  open_action_items_count integer
  calculated_at timestamp [not null]

  indexes {
    employee_id
    review_cycle_id
    calculated_at
  }
}

// ============================================================
// RELATIONSHIPS - CORE HR
// ============================================================
Ref: department.organization_id > organization.id
Ref: department.parent_department_id > department.id
Ref: position.organization_id > organization.id
Ref: employee.organization_id > organization.id
Ref: employee_assignment.employee_id > employee.id
Ref: employee_assignment.department_id > department.id
Ref: employee_assignment.position_id > position.id
Ref: employee_assignment.manager_employee_id > employee.id

// ============================================================
// RELATIONSHIPS - GOAL MANAGEMENT
// ============================================================
Ref: goal_cycle.organization_id > organization.id
Ref: goal_cycle.created_by_employee_id > employee.id
Ref: performance_goal.goal_cycle_id > goal_cycle.id
Ref: performance_goal.organization_id > organization.id
Ref: performance_goal.owner_employee_id > employee.id
Ref: performance_goal.department_id > department.id
Ref: performance_goal.parent_goal_id > performance_goal.id
Ref: performance_goal.created_by_employee_id > employee.id
Ref: performance_goal.approved_by_employee_id > employee.id
Ref: goal_progress_update.goal_id > performance_goal.id
Ref: goal_progress_update.updated_by_employee_id > employee.id
Ref: goal_approval.goal_id > performance_goal.id
Ref: goal_approval.reviewer_employee_id > employee.id
Ref: goal_revision_request.goal_id > performance_goal.id
Ref: goal_revision_request.requested_by_employee_id > employee.id
Ref: goal_history.goal_id > performance_goal.id
Ref: goal_history.changed_by_employee_id > employee.id

// ============================================================
// RELATIONSHIPS - PERFORMANCE REVIEW
// ============================================================
Ref: performance_review_cycle.organization_id > organization.id
Ref: performance_review_cycle.created_by_employee_id > employee.id
Ref: review_template.organization_id > organization.id
Ref: review_template.created_by_employee_id > employee.id
Ref: review_template_section.review_template_id > review_template.id
Ref: review_question.review_template_section_id > review_template_section.id
Ref: performance_review.review_cycle_id > performance_review_cycle.id
Ref: performance_review.review_template_id > review_template.id
Ref: performance_review.employee_id > employee.id
Ref: performance_review.manager_employee_id > employee.id
Ref: review_participant.performance_review_id > performance_review.id
Ref: review_participant.employee_id > employee.id
Ref: review_feedback.performance_review_id > performance_review.id
Ref: review_feedback.reviewer_employee_id > employee.id
Ref: review_answer.review_feedback_id > review_feedback.id
Ref: review_answer.review_question_id > review_question.id
Ref: review_approval.performance_review_id > performance_review.id
Ref: review_approval.approver_employee_id > employee.id
Ref: review_correction_request.performance_review_id > performance_review.id
Ref: review_correction_request.requested_by_employee_id > employee.id
Ref: review_correction_request.resolved_by_employee_id > employee.id
Ref: review_history.performance_review_id > performance_review.id
Ref: review_history.changed_by_employee_id > employee.id

// ============================================================
// RELATIONSHIPS - ONE-ON-ONE COACHING
// ============================================================
Ref: coaching_template.organization_id > organization.id
Ref: coaching_template.created_by_employee_id > employee.id
Ref: coaching_template_item.coaching_template_id > coaching_template.id
Ref: one_on_one_session.organization_id > organization.id
Ref: one_on_one_session.employee_id > employee.id
Ref: one_on_one_session.manager_employee_id > employee.id
Ref: one_on_one_session.coaching_template_id > coaching_template.id
Ref: one_on_one_session.created_by_employee_id > employee.id
Ref: one_on_one_agenda_item.one_on_one_session_id > one_on_one_session.id
Ref: one_on_one_agenda_item.created_by_employee_id > employee.id
Ref: one_on_one_note.one_on_one_session_id > one_on_one_session.id
Ref: one_on_one_note.author_employee_id > employee.id
Ref: coaching_action_item.one_on_one_session_id > one_on_one_session.id
Ref: coaching_action_item.assigned_to_employee_id > employee.id
Ref: coaching_action_item.created_by_employee_id > employee.id
Ref: coaching_history.one_on_one_session_id > one_on_one_session.id
Ref: coaching_history.changed_by_employee_id > employee.id

// ============================================================
// RELATIONSHIPS - REPORTING
// ============================================================
Ref: employee_performance_summary.employee_id > employee.id
Ref: employee_performance_summary.review_cycle_id > performance_review_cycle.id
