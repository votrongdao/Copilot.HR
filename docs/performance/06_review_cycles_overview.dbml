// Review Cycles Overview - screen-specific DBML

Enum review_cycle_status {
  draft
  open
  in_progress
  completed
  archived
}

Enum assignment_status {
  not_started
  in_progress
  submitted
  approved
  overdue
}

Table users {
  id bigint [pk, increment]
  employee_code varchar(50) [not null, unique]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  department varchar(150)
  job_title varchar(150)
  is_active boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table review_cycles {
  id bigint [pk, increment]
  name varchar(255) [not null]
  review_type varchar(50) [not null]
  description text
  start_date date [not null]
  end_date date [not null]
  self_assessment_due_at timestamp
  manager_evaluation_due_at timestamp
  status review_cycle_status [not null]
  created_by bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    status
    start_date
    end_date
  }
}

Table review_assignments {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  employee_id bigint [not null]
  manager_id bigint
  status assignment_status [not null]
  due_date date
  started_at timestamp
  submitted_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]

  Indexes {
    (review_cycle_id, employee_id) [unique]
    status
    manager_id
  }
}

Table review_cycle_participants {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  user_id bigint [not null]
  role varchar(30) [not null]
  invited_at timestamp
  accepted_at timestamp

  Indexes {
    (review_cycle_id, user_id, role) [unique]
  }
}

Table review_cycle_status_history {
  id bigint [pk, increment]
  review_cycle_id bigint [not null]
  old_status review_cycle_status
  new_status review_cycle_status [not null]
  changed_by bigint [not null]
  changed_at timestamp [not null]
  note text

  Indexes {
    (review_cycle_id, changed_at)
  }
}

Ref: users.id < review_cycles.created_by

Ref: review_cycles.id < review_assignments.review_cycle_id
Ref: users.id < review_assignments.employee_id
Ref: users.id < review_assignments.manager_id

Ref: review_cycles.id < review_cycle_participants.review_cycle_id
Ref: users.id < review_cycle_participants.user_id

Ref: review_cycles.id < review_cycle_status_history.review_cycle_id
Ref: users.id < review_cycle_status_history.changed_by
